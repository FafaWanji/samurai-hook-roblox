-- Roblox asset IDs. Empty = code-drawn placeholder (images) or silence (sounds).
-- `node roblox/tools/upload-assets.mjs` uploads everything and fills AssetIds.luau, merged in below.
-- By hand instead: Studio > Asset Manager > Bulk Import, then paste each ID here as "rbxassetid://123456".
-- Sheets: the samurai strips are repacked into grids of `cols` columns so they stay under Roblox's 1024 px limit.

local Assets = {
	sprites = {
		samuraiIdle = { id = "", frameW = 190, frameH = 72, cols = 4 }, -- upload/images/samuraiIdle.png
		samuraiWalk = { id = "", frameW = 190, frameH = 72, cols = 4 },
		samuraiQuick = { id = "", frameW = 190, frameH = 72, cols = 3 },
		samuraiHeavy = { id = "", frameW = 190, frameH = 72, cols = 3 },
		samuraiBlock = { id = "", frameW = 190, frameH = 72, cols = 1 },
		samuraiHurt = { id = "", frameW = 190, frameH = 72, cols = 4 },
		samuraiJump = { id = "", frameW = 190, frameH = 72, cols = 2 },
		samuraiFall = { id = "", frameW = 190, frameH = 72, cols = 2 },
		samuraiCrouch = { id = "", frameW = 190, frameH = 72, cols = 4 },
		nigiri = { id = "", frameW = 36, frameH = 24, cols = 1 },
		-- Generated by make-upload.mjs for the anglerfish fight (Draw.image).
		darkHole = { id = "", frameW = 256, frameH = 256, cols = 1 },
		boat = { id = "", frameW = 296, frameH = 126, cols = 1 }, -- the web build's pixel wasen, prow right
		glow = { id = "", frameW = 128, frameH = 128, cols = 1 },
		["fish.sardine"] = { id = "", frameW = 14, frameH = 8, cols = 1 },
		["fish.mackerel"] = { id = "", frameW = 26, frameH = 14, cols = 1 },
		["fish.piranha"] = { id = "", frameW = 14, frameH = 12, cols = 1 },
		["fish.eel"] = { id = "", frameW = 108, frameH = 30, cols = 1 },
		["fish.pufferfish"] = { id = "", frameW = 27, frameH = 23, cols = 1 },
		["fish.swordfish"] = { id = "", frameW = 75, frameH = 28, cols = 1 },
		["fish.anglerfish"] = { id = "", frameW = 55, frameH = 44, cols = 1 },
		["fish.shark"] = { id = "", frameW = 94, frameH = 30, cols = 1 },
		["fish.squid"] = { id = "", frameW = 62, frameH = 52, cols = 1 },
	},
	-- Sound effects: upload/audio/<name>.*  Volume is the web build's.
	sounds = {
		uiMove = { id = "", volume = 0.5 },
		uiConfirm = { id = "", volume = 0.5 },
		uiDeny = { id = "", volume = 0.6 }, -- no file in the web build (synth blip); optional
		splash = { id = "", volume = 0.7 },
		hooked = { id = "", volume = 0.6 }, -- synth in the web build; optional
		gong = { id = "", volume = 0.7 },
		slash = { id = "", volume = 0.6 },
		heavy = { id = "", volume = 0.7 },
		hit = { id = "", volume = 0.7 },
		slip = { id = "", volume = 0.5 },
		tell = { id = "", volume = 0.4 },
		bite = { id = "", volume = 0.6 }, -- synth in the web build; optional
		block = { id = "", volume = 0.6 },
		dash = { id = "", volume = 0.5 },
		ko = { id = "", volume = 0.8 },
		lose = { id = "", volume = 0.6 }, -- synth in the web build; optional
		coin = { id = "", volume = 0.5 },
		buy = { id = "", volume = 0.6 },
	},
	music = {
		ocean = { id = "", volume = 0.35 },
		fight = { id = "", volume = 0.4 },
	},
	-- Announcer clips. "round" is the generic one used from round 6 on.
	voice = {
		fight = "", win = "", perfect = "", timeout = "", ko = "",
		round = "", round1 = "", round2 = "", round3 = "", round4 = "", round5 = "",
	},
}

-- IDs uploaded by roblox/tools/upload-assets.mjs (file names in roblox/upload/ map onto the keys above).
local uploaded = require(script.Parent.AssetIds)
for name, v in uploaded do
	local music = string.match(name, "^music%-(.+)$")
	local voice = string.match(name, "^voice%-(.+)$")
	if Assets.sprites[name] then
		Assets.sprites[name].id = v.id
		Assets.sprites[name].decal = v.decal
	elseif Assets.sounds[name] then
		Assets.sounds[name].id = v.id
	elseif music and Assets.music[music] then
		Assets.music[music].id = v.id
	elseif voice and Assets.voice[voice] ~= nil then
		Assets.voice[voice] = v.id
	end
end

--- The image ID for a sprite sheet, or "" for the placeholder. A sprite uploaded as a Decal only has an
--- image ID once the server has looked it up (src/server: resolveDecals), stored as an attribute.
function Assets.image(key: string): string
	local s = Assets.sprites[key]
	if not s or s.id == "" then
		return ""
	end
	if s.decal then
		return script.Parent:GetAttribute("img_" .. key) or ""
	end
	return s.id
end

return Assets
